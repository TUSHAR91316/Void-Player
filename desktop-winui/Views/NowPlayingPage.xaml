<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VoidPlayer.WinUI.Views.NowPlayingPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:VoidPlayer.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToPlayPauseIconConverter x:Key="BoolToPlayPauseIconConverter"/>
        <converters:RepeatModeToIconConverter x:Key="RepeatModeToIconConverter"/>
        <converters:RepeatModeToOpacityConverter x:Key="RepeatModeToOpacityConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:VolumeToIconConverter x:Key="VolumeToIconConverter"/>
    </Page.Resources>

    <Grid Background="#070C0A"
          Padding="32,20,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: Collapse Chevron & Title & Hi-Res Badge & Equalizer Shortcut -->
        <Grid Grid.Row="0"
              Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal"
                        Spacing="14"
                        VerticalAlignment="Center">
                <Button Width="38"
                        Height="38"
                        CornerRadius="19"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnBackClick"
                        ToolTipService.ToolTip="Collapse Now Playing">
                    <FontIcon Glyph="&#xE70D;"
                              FontSize="16"/>
                </Button>
                <TextBlock Text="Now Playing"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Center/Right: Dynamic Hi-Res Badge & DSP Actions -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12"
                        VerticalAlignment="Center">
                <!-- Dynamic Hi-Res Codec Badge -->
                <Border Background="{x:Bind ViewModel.DynamicGlowBrush, Mode=OneWay}"
                        BorderBrush="{x:Bind ViewModel.DynamicBorderBrush, Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12,5,12,5">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Player.CurrentSong.CodecBadge, Mode=OneWay, FallbackValue='FLAC Hi-Res'}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="ⓘ"
                                   FontSize="11"
                                   Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- MAIN SPLIT: Player & Controls on Left, Dynamic Tabs & Panels on Right -->
        <Grid Grid.Row="1"
              ColumnSpacing="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Big Glowing Vinyl / Artwork & Playback Controls -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20"
                            MaxWidth="500"
                            HorizontalAlignment="Center">

                    <!-- Ambient Glow backdrop + Artwork Card -->
                    <Grid Width="340"
                          Height="340"
                          HorizontalAlignment="Center">
                        <!-- Dynamic Ambient Glow halo -->
                        <Border Width="340"
                                Height="340"
                                CornerRadius="170"
                                Background="{x:Bind ViewModel.DynamicGlowBrush, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        <!-- Artwork Container -->
                        <Border Width="310"
                                Height="310"
                                CornerRadius="16"
                                Background="#0E1713"
                                BorderBrush="{x:Bind ViewModel.DynamicBorderBrush, Mode=OneWay}"
                                BorderThickness="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Grid>
                                <!-- Standard Artwork (visible in Cover / Queue / Specs mode) -->
                                <Grid Visibility="{x:Bind CoverVisibility, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE8D6;"
                                              FontSize="80"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                                    <Image Stretch="UniformToFill"
                                           Source="{Binding ViewModel.Player.CurrentSong.ArtCachePath, ElementName=RootPage, Converter={StaticResource StringToImageSourceConverter}}"
                                           Visibility="{Binding ViewModel.Player.CurrentSong.ArtCachePath, ElementName=RootPage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </Grid>

                                <!-- Acoustic Waveform Visualizer (AM Waveform design matching screenshot) -->
                                <Grid Visibility="{x:Bind LyricsVisibility, Mode=OneWay}"
                                      Background="#0A120E"
                                      Padding="20">
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Spacing="16">
                                        <!-- Waveform Bars Representation -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">
                                            <Border Width="3"
                                                    Height="24"
                                                    Background="#FFFFFF"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="42"
                                                    Background="#FFFFFF"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="68"
                                                    Background="#FFFFFF"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="96"
                                                    Background="#FFFFFF"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="130"
                                                    Background="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="150"
                                                    Background="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="120"
                                                    Background="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="80"
                                                    Background="#FFFFFF"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="50"
                                                    Background="#FFFFFF"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="70"
                                                    Background="#FFFFFF"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="110"
                                                    Background="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="140"
                                                    Background="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="110"
                                                    Background="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="75"
                                                    Background="#FFFFFF"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="40"
                                                    Background="#FFFFFF"
                                                    CornerRadius="1"/>
                                            <Border Width="3"
                                                    Height="20"
                                                    Background="#FFFFFF"
                                                    CornerRadius="1"/>
                                        </StackPanel>
                                        <TextBlock Text="Acoustic Waveform Active"
                                                   FontSize="11"
                                                   Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Song Titles & Favorite Button -->
                    <Grid HorizontalAlignment="Stretch"
                          Margin="8,0,8,0">
                        <StackPanel Spacing="4"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420">
                            <TextBlock Text="{x:Bind ViewModel.Player.CurrentSong.Title, Mode=OneWay, FallbackValue='No Track Selected'}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.Player.CurrentSong.Artist, Mode=OneWay, FallbackValue='Unknown Artist'}"
                                       FontSize="15"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.Player.CurrentSong.Album, Mode=OneWay, FallbackValue=''}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextAlignment="Center"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="40"
                                Height="40"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnFavoriteClick"
                                ToolTipService.ToolTip="Toggle Favorite">
                            <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}"
                                      FontSize="18"
                                      Foreground="{x:Bind FavoriteBrush, Mode=OneWay}"/>
                        </Button>
                    </Grid>

                    <!-- Seek Slider -->
                    <Grid Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Slider Grid.Row="0"
                                Minimum="0"
                                Maximum="{x:Bind TotalSeconds, Mode=OneWay}"
                                Value="{x:Bind CurrentSeconds, Mode=TwoWay}"
                                Height="30"
                                Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"/>

                        <Grid Grid.Row="1"
                              Margin="4,-4,4,0">
                            <TextBlock Text="{x:Bind CurrentPositionText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind TotalDurationText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <!-- Playback Action Buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="18">
                        <!-- Shuffle -->
                        <Button Width="40"
                                Height="40"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnShuffleClick"
                                Opacity="{x:Bind ViewModel.Player.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
                                ToolTipService.ToolTip="Shuffle">
                            <FontIcon Glyph="&#xE8B1;"
                                      FontSize="17"/>
                        </Button>

                        <!-- Previous -->
                        <Button Width="44"
                                Height="44"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnPreviousClick"
                                ToolTipService.ToolTip="Previous Track">
                            <FontIcon Glyph="&#xE892;"
                                      FontSize="19"/>
                        </Button>

                        <!-- Big Play / Pause with Dynamic Accent Background -->
                        <Button Width="60"
                                Height="60"
                                CornerRadius="30"
                                Background="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                Click="OnPlayPauseClick"
                                ToolTipService.ToolTip="Play / Pause">
                            <FontIcon Glyph="{x:Bind ViewModel.Player.IsPlaying, Mode=OneWay, Converter={StaticResource BoolToPlayPauseIconConverter}}"
                                      FontSize="24"
                                      Foreground="#000000"/>
                        </Button>

                        <!-- Next -->
                        <Button Width="44"
                                Height="44"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnNextClick"
                                ToolTipService.ToolTip="Next Track">
                            <FontIcon Glyph="&#xE893;"
                                      FontSize="19"/>
                        </Button>

                        <!-- Repeat -->
                        <Button Width="40"
                                Height="40"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnRepeatClick"
                                Opacity="{x:Bind ViewModel.Player.RepeatMode, Mode=OneWay, Converter={StaticResource RepeatModeToOpacityConverter}}"
                                ToolTipService.ToolTip="Repeat Mode">
                            <FontIcon Glyph="{x:Bind ViewModel.Player.RepeatMode, Mode=OneWay, Converter={StaticResource RepeatModeToIconConverter}}"
                                      FontSize="17"/>
                        </Button>
                    </StackPanel>

                    <!-- BOTTOM TABS: Cover | Lyrics | Queue | Speed & Specs -->
                    <Border Background="#0C1410"
                            BorderBrush="#1A2B21"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="4"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    Background="{x:Bind CoverPillBg, Mode=OneWay}"
                                    CornerRadius="16"
                                    Padding="12,5,12,5"
                                    Click="OnCoverTabClick">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <TextBlock Text="Cover"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{x:Bind CoverPillFg, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    Background="{x:Bind LyricsPillBg, Mode=OneWay}"
                                    CornerRadius="16"
                                    Padding="12,5,12,5"
                                    Click="OnLyricsTabClick">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <TextBlock Text="Lyrics"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{x:Bind LyricsPillFg, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    Background="{x:Bind QueuePillBg, Mode=OneWay}"
                                    CornerRadius="16"
                                    Padding="12,5,12,5"
                                    Click="OnQueueTabClick">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <TextBlock Text="Queue"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{x:Bind QueuePillFg, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    Background="{x:Bind SpecsPillBg, Mode=OneWay}"
                                    CornerRadius="16"
                                    Padding="12,5,12,5"
                                    Click="OnSpecsTabClick">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <TextBlock Text="Speed &amp; Specs"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{x:Bind SpecsPillFg, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: DYNAMIC TAB PANELS -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">

                    <!-- PANEL 1: COVER MODE (Specs Card + Queue Preview) -->
                    <StackPanel Spacing="16"
                                Visibility="{x:Bind CoverVisibility, Mode=OneWay}">
                        <!-- Audio Codec Card Header -->
                        <Border Background="#0C1410"
                                BorderBrush="#1A2B21"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <FontIcon Glyph="&#xE995;"
                                                  FontSize="18"
                                                  Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="Audio Codec &amp; Stream Info"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right"
                                            Background="{x:Bind ViewModel.DynamicGlowBrush, Mode=OneWay}"
                                            BorderBrush="{x:Bind ViewModel.DynamicBorderBrush, Mode=OneWay}"
                                            BorderThickness="1"
                                            Padding="8,2,8,2"
                                            CornerRadius="4">
                                        <TextBlock Text="{x:Bind ViewModel.Player.CurrentSong.CodecInfo.QualityTier, Mode=OneWay, FallbackValue='Lossless Hi-Fi'}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"/>
                                    </Border>
                                </Grid>

                                <Border Height="1"
                                        Background="#16251D"/>

                                <!-- Codec Properties Grid -->
                                <Grid RowSpacing="10"
                                      ColumnSpacing="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="Format / Codec"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="13"/>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Player.CurrentSong.CodecInfo.StreamProfile, Mode=OneWay, FallbackValue='—'}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="Bitrate"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="13"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Player.CurrentSong.CodecInfo.FormattedBitrate, Mode=OneWay, FallbackValue='—'}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="Sample Rate"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="13"/>
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Player.CurrentSong.CodecInfo.FormattedSampleRate, Mode=OneWay, FallbackValue='—'}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Text="Channel Layout"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="13"/>
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Player.CurrentSong.CodecInfo.ChannelsDescription, Mode=OneWay, FallbackValue='—'}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               Text="Bit Depth"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="13"/>
                                    <TextBlock Grid.Row="4"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Player.CurrentSong.CodecInfo.FormattedBitDepth, Mode=OneWay, FallbackValue='—'}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>

                                    <TextBlock Grid.Row="5"
                                               Grid.Column="0"
                                               Text="File Size"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="13"/>
                                    <TextBlock Grid.Row="5"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Player.CurrentSong.CodecInfo.FormattedFileSize, Mode=OneWay, FallbackValue='—'}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Up Next Preview Card -->
                        <Border Background="#0C1410"
                                BorderBrush="#1A2B21"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="Up Next"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Click="OnQueueTabClick">
                                        <TextBlock Text="View All"
                                                   FontSize="12"
                                                   Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"/>
                                    </Button>
                                </Grid>
                                <ListView ItemsSource="{x:Bind ViewModel.Player.Queue, Mode=OneWay}"
                                          MaxHeight="180"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="4,4,4,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="Medium"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Artist}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FormattedDuration}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PANEL 2: LYRICS MODE (Live Acoustic Lyrics Sheet) -->
                    <Border Background="#0C1410"
                            BorderBrush="#1A2B21"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24"
                            Visibility="{x:Bind LyricsVisibility, Mode=OneWay}">
                        <StackPanel Spacing="20">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE93C;"
                                              FontSize="16"
                                              Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"/>
                                    <TextBlock Text="Lyrics"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right"
                                        Background="#112219"
                                        CornerRadius="4"
                                        Padding="8,2,8,2">
                                    <TextBlock Text="{x:Bind LyricsStatusText, Mode=OneWay}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#00E575"/>
                                </Border>
                            </Grid>

                            <Border Height="1"
                                    Background="#16251D"/>

                            <ScrollViewer MaxHeight="360"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind LyricsText, Mode=OneWay}"
                                           FontSize="16"
                                           LineHeight="28"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- PANEL 3: QUEUE MODE (Full Interactive Queue) -->
                    <Border Background="#0C1410"
                            BorderBrush="#1A2B21"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Visibility="{x:Bind QueueVisibility, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE90B;"
                                              FontSize="16"
                                              Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"/>
                                    <TextBlock Text="Now Playing Queue"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{x:Bind QueueCountText, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1"
                                    Background="#16251D"/>

                            <ListView ItemsSource="{x:Bind ViewModel.Player.Queue, Mode=OneWay}"
                                      MaxHeight="450"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,6,4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Play indicator button -->
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Padding="6"
                                                    Margin="0,0,8,0"
                                                    Click="OnQueueItemPlayClick">
                                                <FontIcon Glyph="&#xE768;"
                                                          FontSize="13"/>
                                            </Button>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding FormattedDuration}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,8,0"/>

                                            <Button Grid.Column="3"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Padding="6"
                                                    Click="OnQueueItemRemoveClick"
                                                    ToolTipService.ToolTip="Remove from queue">
                                                <FontIcon Glyph="&#xE74D;"
                                                          FontSize="12"
                                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- PANEL 4: SPECS & SPEED MODE -->
                    <StackPanel Spacing="16"
                                Visibility="{x:Bind SpecsVisibility, Mode=OneWay}">
                        <!-- Playback Speed Card -->
                        <Border Background="#0C1410"
                                BorderBrush="#1A2B21"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xEC57;"
                                              FontSize="16"
                                              Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Playback Speed"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Adjust pitch-corrected stream playback rate in real-time:"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <Button x:Name="NowPlayingSpeed05Button"
                                            Content="0.5x"
                                            Tag="0.5"
                                            Click="OnSpeedClick"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="12,5,12,5"
                                            FontSize="12"/>
                                    <Button x:Name="NowPlayingSpeed075Button"
                                            Content="0.75x"
                                            Tag="0.75"
                                            Click="OnSpeedClick"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="12,5,12,5"
                                            FontSize="12"/>
                                    <Button x:Name="NowPlayingSpeed10Button"
                                            Content="1.0x"
                                            Tag="1.0"
                                            Click="OnSpeedClick"
                                            Style="{StaticResource DefaultButtonStyle}"
                                            Padding="12,5,12,5"
                                            FontSize="12"/>
                                    <Button x:Name="NowPlayingSpeed125Button"
                                            Content="1.25x"
                                            Tag="1.25"
                                            Click="OnSpeedClick"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="12,5,12,5"
                                            FontSize="12"/>
                                    <Button x:Name="NowPlayingSpeed15Button"
                                            Content="1.5x"
                                            Tag="1.5"
                                            Click="OnSpeedClick"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="12,5,12,5"
                                            FontSize="12"/>
                                    <Button x:Name="NowPlayingSpeed20Button"
                                            Content="2.0x"
                                            Tag="2.0"
                                            Click="OnSpeedClick"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="12,5,12,5"
                                            FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hardware Audio Pipeline Specs Card -->
                        <Border Background="#0C1410"
                                BorderBrush="#1A2B21"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE950;"
                                              FontSize="16"
                                              Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Hardware Audio Pipeline"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Height="1"
                                        Background="#16251D"/>

                                <Grid RowSpacing="10"
                                      ColumnSpacing="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="Driver Engine"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"/>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Player.AudioPipelineStatus, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#00E575"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="Sample Precision"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Player.CurrentSong.CodecInfo.FormattedBitDepth, Mode=OneWay, FallbackValue='24-bit Floating Point'}"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="Internal Buffer"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"/>
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="Adaptive LibVLC audio buffer"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Text="Output Device"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"/>
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{x:Bind ViewModel.Player.AudioOutputDeviceStatus, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
