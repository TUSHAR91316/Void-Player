<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VoidPlayer.WinUI.Views.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VoidPlayer.WinUI.Models"
    xmlns:converters="using:VoidPlayer.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Page.Resources>

    <Grid Padding="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER & ACTIONS -->
        <Grid Grid.Row="0"
              Margin="0,0,0,24">
            <StackPanel Spacing="4">
                <TextBlock Text="Albums"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"/>
                <TextBlock Text="{x:Bind HeaderStatsText, Mode=OneWay}"
                           Foreground="#8B9E94"
                           FontSize="13"/>
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource SubtleButtonStyle}"
                    Click="OnAddFolderClick"
                    ToolTipService.ToolTip="Add Music Folder">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xED25;"
                              FontSize="15"
                              Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"/>
                    <TextBlock Text="Add Folder"
                               FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- EMPTY STATE (Shown when 0 albums) -->
        <Border Grid.Row="1"
                Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}"
                Background="#0B130F"
                BorderBrush="#1A2D22"
                BorderThickness="1"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="40"
                MaxWidth="480">
            <StackPanel Spacing="16"
                        HorizontalAlignment="Center">
                <Border Width="80"
                        Height="80"
                        CornerRadius="40"
                        Background="{x:Bind ViewModel.DynamicGlowBrush, Mode=OneWay}"
                        BorderBrush="{x:Bind ViewModel.DynamicBorderBrush, Mode=OneWay}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE93C;"
                              FontSize="32"
                              Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="6"
                            HorizontalAlignment="Center">
                    <TextBlock Text="No Albums Found"
                               FontSize="20"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="Add your music folders to explore albums with high-resolution artwork."
                               FontSize="13"
                               Foreground="#8B9E94"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="20,10,20,10"
                        Click="OnAddFolderClick">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xED25;"
                                  FontSize="14"/>
                        <TextBlock Text="Choose Music Folder"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ALBUMS GRID -->
        <GridView Grid.Row="1"
                  Visibility="{x:Bind AlbumsListVisibility, Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.Library.Albums, Mode=OneWay}"
                  ItemClick="OnAlbumClick"
                  IsItemClickEnabled="True"
                  SelectionMode="None">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"
                                   ItemWidth="190"
                                   ItemHeight="250"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:AlbumItem">
                    <Border Background="#0D1612"
                            BorderBrush="#1E3327"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Width="175"
                            Height="235">
                        <StackPanel Spacing="10">
                            <!-- Album Art -->
                            <Grid Width="151"
                                  Height="151"
                                  CornerRadius="8">
                                <Border Background="#122019"
                                        CornerRadius="8">
                                    <FontIcon Glyph="&#xE93C;"
                                              FontSize="36"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <Image Stretch="UniformToFill"
                                       Source="{x:Bind ArtCacheImageSource, Mode=OneTime}"
                                       Visibility="{Binding ArtCachePath, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>

                            <!-- Titles -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="#FFFFFF"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Artist}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind FormattedTrackCount}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
