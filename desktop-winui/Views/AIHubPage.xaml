<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VoidPlayer.WinUI.Views.AIHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VoidPlayer.WinUI.Models"
    xmlns:converters="using:VoidPlayer.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="32,24,32,48"
              MaxWidth="1280"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. PAGE HEADER -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,24">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"/>
                        <TextBlock Text="AI Intelligence Hub"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                    </StackPanel>
                    <TextBlock Text="Real-time acoustic analysis, listening persona, and mood curation"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="13"/>
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnRefreshClick">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE72C;"
                                  FontSize="14"/>
                        <TextBlock Text="Re-Analyze"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 2. HERO LISTENING PERSONA CARD (Matches docs/screenshots/ai_hub.jpg) -->
            <Border Grid.Row="1"
                    Background="#0D1612"
                    BorderBrush="#1E3327"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Persona Header: VOID AI INSIGHTS & Total Playtime -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <TextBlock Text="VOID AI INSIGHTS"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#FFB800"
                                       VerticalAlignment="Center"/>
                            <Border Background="#1A2D23"
                                    BorderBrush="#254A36"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2,6,2">
                                <TextBlock Text="{x:Bind SmlStatusBadgeText, Mode=OneWay}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#00E676"/>
                            </Border>
                        </StackPanel>

                        <Border HorizontalAlignment="Right"
                                Background="#1A241E"
                                CornerRadius="6"
                                Padding="10,3,10,3">
                            <TextBlock Text="{x:Bind TotalPlaytimeBadgeText, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#8B9E94"/>
                        </Border>
                    </Grid>

                    <!-- Persona Title & Description -->
                    <StackPanel Grid.Row="1"
                                Spacing="8"
                                Margin="0,0,0,20">
                        <TextBlock Text="{x:Bind PersonaDisplayTitle, Mode=OneWay}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="{x:Bind PersonaDescriptionText, Mode=OneWay}"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="900"/>
                        <TextBlock Text="{x:Bind SubtitleStatsText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{x:Bind LibraryProfileText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{x:Bind AcousticEnergyBadgeText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="#F59E0B"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Row="2"
                            Height="1"
                            Background="#16251D"
                            Margin="0,0,0,20"/>

                    <!-- Mood Distribution Bars & AI Suggested EQ Pill -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="LIBRARY MOOD PROFILE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Margin="0,0,0,12"/>

                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.AiInsights.MoodDistribution, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MoodScoreItem">
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind MoodName}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="#D1D5DB"
                                                   VerticalAlignment="Center"/>

                                        <ProgressBar Grid.Column="1"
                                                     Value="{x:Bind ScorePercentage}"
                                                     Maximum="100"
                                                     Height="8"
                                                     CornerRadius="4"
                                                     Foreground="{x:Bind ColorHex}"
                                                     Background="#132019"
                                                     VerticalAlignment="Center"
                                                     Margin="12,0,16,0"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind FormattedScore}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- AI Suggested EQ Pill Button (matching screenshot) -->
                        <Button Grid.Row="2"
                                Style="{StaticResource SubtleButtonStyle}"
                                Background="#14211A"
                                BorderBrush="#20382B"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16,8,16,8"
                                HorizontalAlignment="Left"
                                Margin="0,20,0,0"
                                Click="OnApplySuggestedEqClick">
                            <TextBlock Text="{x:Bind SuggestedEqText, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. AI DJ SMART FLOW BANNER (Matches docs/screenshots/ai_hub.jpg) -->
            <Border Grid.Row="2"
                    Background="#0B130F"
                    BorderBrush="#1A2920"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Circular Icon -->
                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#112219"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEA80;"
                                  FontSize="18"
                                  Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Text="AI DJ Smart Flow"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="Tap to enable continuous AI smart track queue"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <ToggleSwitch Grid.Column="2"
                                  IsOn="{x:Bind ViewModel.IsSmartFlowActive, Mode=TwoWay}"
                                  OnContent="Enabled"
                                  OffContent="Disabled"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 4. SMART CATEGORIES HEADER -->
            <Grid Grid.Row="3"
                  Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="AI Smart Categories"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        Background="#101D17"
                        BorderBrush="#1E3327"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,3,10,3">
                    <TextBlock Text="{x:Bind CategoryCountText, Mode=OneWay}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"/>
                </Border>
            </Grid>

            <!-- 5. 9 SMART CATEGORIES GRID -->
            <GridView Grid.Row="4"
                      ItemsSource="{x:Bind ViewModel.AiCategories, Mode=OneWay}"
                      IsItemClickEnabled="True"
                      ItemClick="OnCategoryClick"
                      SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"
                                       MaximumRowsOrColumns="3"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:AiCategoryItem">
                        <Border Width="360"
                                Height="140"
                                Margin="0,0,16,16"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{x:Bind BackgroundBrush}">
                            <Grid Padding="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Icon, Confidence & Track Count Badges -->
                                <Grid Grid.Row="0">
                                    <FontIcon Glyph="{x:Bind IconGlyph}"
                                              FontSize="20"
                                              Foreground="White"
                                              HorizontalAlignment="Left"/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="6">
                                        <Border Background="#26000000"
                                                CornerRadius="10"
                                                Padding="7,2,7,2">
                                            <TextBlock Text="{x:Bind SmlConfidenceText}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#A7F3D0"/>
                                        </Border>
                                        <Border Background="#33000000"
                                                CornerRadius="10"
                                                Padding="8,2,8,2">
                                            <TextBlock Text="{x:Bind FormattedTrackCount}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Title, Subtitle and Detected Genres -->
                                <StackPanel Grid.Row="1"
                                            VerticalAlignment="Center"
                                            Margin="0,4,0,0">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               FontSize="12"
                                               Foreground="#CCFFFFFF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind DetectedGenreSummary}"
                                               FontSize="11"
                                               Foreground="#99FFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Play Hint Button -->
                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom">
                                        <TextBlock Text="Play Station"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                        <FontIcon Glyph="&#xE768;"
                                                  FontSize="12"
                                                  Foreground="White"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Border Grid.Row="5"
                    Visibility="{x:Bind CategoryDetailsVisibility, Mode=OneWay}"
                    Background="#0B130F"
                    BorderBrush="#1E3327"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,4,0,0">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind SelectedCategory.Title, Mode=OneWay}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="{x:Bind SelectedCategory.FormattedTrackCount, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnPlayCategoryClick">
                            <StackPanel Orientation="Horizontal"
                                    Spacing="7">
                                <FontIcon Glyph="&#xE768;"
                                        FontSize="13"/>
                                <TextBlock Text="Play Category"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListView ItemsSource="{x:Bind SelectedCategory.Songs, Mode=OneWay}"
                              MaxHeight="260"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SongItem">
                                <Grid Padding="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Artist}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Width="34"
                                            Height="34"
                                            Padding="0"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Click="OnPlayCategorySongClick"
                                            ToolTipService.ToolTip="Play song">
                                        <FontIcon Glyph="&#xE768;"
                                                FontSize="13"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
