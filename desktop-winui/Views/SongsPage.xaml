<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VoidPlayer.WinUI.Views.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VoidPlayer.WinUI.Models"
    xmlns:converters="using:VoidPlayer.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToHeartGlyphConverter x:Key="BoolToHeartGlyphConverter"/>
        <converters:BoolToHeartBrushConverter x:Key="BoolToHeartBrushConverter"/>
        <converters:PlayingRowBackgroundConverter x:Key="PlayingRowBackgroundConverter"/>
    </Page.Resources>

    <Grid Padding="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER & ACTIONS -->
        <Grid Grid.Row="0"
              Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Void Player"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"/>
                <TextBlock Text="{x:Bind HeaderStatsText, Mode=OneWay}"
                           Foreground="#8B9E94"
                           FontSize="13"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Spacing="10">
                <AutoSuggestBox Width="260"
                                PlaceholderText="Search library..."
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"/>

                <Button Style="{StaticResource SubtleButtonStyle}"
                        Click="OnAddFolderClick"
                        ToolTipService.ToolTip="Open &amp; Add Music Folder">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <FontIcon Glyph="&#xED25;"
                                  FontSize="15"
                                  Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"/>
                        <TextBlock Text="Add Folder"
                                   FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SubtleButtonStyle}"
                        Click="OnScanClick"
                        ToolTipService.ToolTip="Rescan Library">
                    <FontIcon Glyph="&#xE72C;"
                              FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ACTION BUTTONS & FILTER PILLS & SORT -->
        <Grid Grid.Row="1"
              Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Play All, Shuffle All, Filter Pills -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10">
                <Button Style="{StaticResource AccentButtonStyle}"
                        Click="OnPlayAllClick">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE768;"
                                  FontSize="14"/>
                        <TextBlock Text="Play All"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource DefaultButtonStyle}"
                        Click="OnShuffleAllClick">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE8B1;"
                                  FontSize="14"/>
                        <TextBlock Text="Shuffle All"/>
                    </StackPanel>
                </Button>

                <!-- Filter Pills -->
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Background="{x:Bind AllPillBackground, Mode=OneWay}"
                        BorderBrush="{x:Bind AllPillBorder, Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14,6,14,6"
                        Click="OnFilterAllClick">
                    <TextBlock Text="{x:Bind AllFilterText, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{x:Bind AllPillForeground, Mode=OneWay}"/>
                </Button>

                <Button Style="{StaticResource SubtleButtonStyle}"
                        Background="{x:Bind FavsPillBackground, Mode=OneWay}"
                        BorderBrush="{x:Bind FavsPillBorder, Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14,6,14,6"
                        Click="OnFilterFavsClick">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <FontIcon Glyph="&#xEB52;"
                                  FontSize="12"
                                  Foreground="#F43F5E"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind FavsFilterText, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{x:Bind FavsPillForeground, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Right: Sort Menu Dropdown -->
            <DropDownButton Grid.Column="1"
                            Content="{x:Bind CurrentSortText, Mode=OneWay}"
                            Style="{StaticResource SubtleButtonStyle}">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Sort: Title"
                                        Click="OnSortTitleClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8D6;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Sort: Artist"
                                        Click="OnSortArtistClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE77B;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Sort: Album"
                                        Click="OnSortAlbumClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE93C;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Sort: Duration"
                                        Click="OnSortDurationClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE823;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Sort: Date Added"
                                        Click="OnSortDateAddedClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEC92;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- EMPTY STATE (Shown when library is empty) -->
        <Border Grid.Row="2"
                Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}"
                Background="#0B130F"
                BorderBrush="#1A2D22"
                BorderThickness="1"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="40"
                MaxWidth="480">
            <StackPanel Spacing="16"
                        HorizontalAlignment="Center">
                <Border Width="80"
                        Height="80"
                        CornerRadius="40"
                        Background="{x:Bind ViewModel.DynamicGlowBrush, Mode=OneWay}"
                        BorderBrush="{x:Bind ViewModel.DynamicBorderBrush, Mode=OneWay}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xED25;"
                              FontSize="32"
                              Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="6"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Your Void Library is Empty"
                               FontSize="20"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="Select a music folder on your PC to load lossless Hi-Fi tracks."
                               FontSize="13"
                               Foreground="#8B9E94"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="20,10,20,10"
                        Click="OnAddFolderClick">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xED25;"
                                  FontSize="14"/>
                        <TextBlock Text="Choose Music Folder"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- VIRTUALIZED SONGS LIST -->
        <ListView x:Name="SongsListView"
                  Grid.Row="2"
                  Visibility="{x:Bind SongsListVisibility, Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.FilteredSongs, Mode=OneWay}"
                  ItemClick="OnSongItemClick"
                  IsItemClickEnabled="True"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <!-- Virtualization Properties for Minimal RAM -->
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel CacheLength="2"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.Header>
                <Grid Padding="12,8,12,8"
                      BorderBrush="#1A2D22"
                      BorderThickness="0,0,0,1"
                      Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"
                                          MinWidth="140"/>
                        <ColumnDefinition Width="Auto"
                                          MinWidth="96"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="70"
                                          MinWidth="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="#"
                               Foreground="#8B9E94"
                               FontSize="12"/>
                    <TextBlock Grid.Column="1"
                               Text="Title"
                               Foreground="#8B9E94"
                               FontSize="12"/>
                    <TextBlock Grid.Column="2"
                               Text="Album"
                               Foreground="#8B9E94"
                               FontSize="12"/>
                    <TextBlock Grid.Column="3"
                               Text="Codec"
                               Foreground="#8B9E94"
                               FontSize="12"/>
                    <TextBlock Grid.Column="4"
                               Text=""
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5"
                               Text="Time"
                               Foreground="#8B9E94"
                               FontSize="12"
                               HorizontalAlignment="Right"/>
                </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SongItem">
                    <Border Background="{x:Bind IsCurrentlyPlaying, Mode=OneWay, Converter={StaticResource PlayingRowBackgroundConverter}}"
                            BorderBrush="{x:Bind IsCurrentlyPlaying, Mode=OneWay, Converter={StaticResource PlayingRowBackgroundConverter}}"
                            BorderThickness="3,0,0,0"
                            Padding="4,6,4,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"
                                                  MinWidth="140"/>
                                <ColumnDefinition Width="Auto"
                                                  MinWidth="96"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="70"
                                                  MinWidth="64"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail or Note Icon -->
                            <Grid Grid.Column="0"
                                  Width="36"
                                  Height="36"
                                  CornerRadius="6">
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                    <FontIcon Glyph="&#xE8D6;"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <Image Stretch="UniformToFill"
                                       Source="{x:Bind ArtCacheImageSource, Mode=OneTime}"
                                       Visibility="{Binding ArtCachePath, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>

                            <!-- Title and Artist -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="8,0,12,0">
                                <TextBlock Text="{x:Bind Title}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Artist}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Album -->
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind Album}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Codec Pill Badge -->
                            <Border Grid.Column="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Padding="6,2,6,2"
                                    CornerRadius="4"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind CodecBadge}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>

                            <!-- Favorite Toggle Heart Button -->
                            <Button Grid.Column="4"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnItemFavoriteClick"
                                    Tag="{x:Bind}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Favorite">
                                <FontIcon Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToHeartGlyphConverter}}"
                                          FontSize="13"
                                          Foreground="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToHeartBrushConverter}}"/>
                            </Button>

                            <!-- Duration -->
                            <TextBlock Grid.Column="5"
                                       Text="{x:Bind FormattedDuration}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
