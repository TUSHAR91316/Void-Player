<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VoidPlayer.WinUI.Views.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VoidPlayer.WinUI.Models"
    xmlns:converters="using:VoidPlayer.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToHeartGlyphConverter x:Key="BoolToHeartGlyphConverter"/>
        <converters:BoolToHeartBrushConverter x:Key="BoolToHeartBrushConverter"/>
        <converters:PlayingRowBackgroundConverter x:Key="PlayingRowBackgroundConverter"/>
        <converters:PlayingTitleBrushConverter x:Key="PlayingTitleBrushConverter"/>
        <converters:TrueToVisibleConverter x:Key="TrueToVisibleConverter"/>
    </Page.Resources>

    <Grid Padding="32,28,32,0" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: page title + list stats, library actions on the right. Search lives in the nav pane. -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Bottom">
                <TextBlock Text="Songs"
                           Style="{StaticResource VoidPageTitleTextStyle}"/>
                <TextBlock Text="{x:Bind HeaderStatsText, Mode=OneWay}"
                           FontSize="13"
                           Foreground="{StaticResource VoidTextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Spacing="8">
                <Button Style="{StaticResource VoidSecondaryButtonStyle}"
                        Background="Transparent"
                        Click="OnAddFolderClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xED25;" FontSize="14"/>
                        <TextBlock Text="Add folder"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource VoidSecondaryButtonStyle}"
                        Background="Transparent"
                        Width="36"
                        Padding="0"
                        Click="OnScanClick"
                        AutomationProperties.Name="Rescan library"
                        ToolTipService.ToolTip="Rescan library">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- TOOLBAR: one accent action, secondary shuffle, segmented filter, sort -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource VoidAccentButtonStyle}"
                    Click="OnPlayAllClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="13"/>
                    <TextBlock Text="Play all"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    Style="{StaticResource VoidSecondaryButtonStyle}"
                    Click="OnShuffleAllClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B1;" FontSize="13"/>
                    <TextBlock Text="Shuffle"/>
                </StackPanel>
            </Button>

            <Border Grid.Column="2"
                    Margin="8,0,0,0"
                    Style="{StaticResource VoidSegmentHostStyle}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Background="{x:Bind AllPillBackground, Mode=OneWay}"
                            Height="28"
                            Padding="12,0,12,0"
                            Click="OnFilterAllClick"
                            AutomationProperties.Name="Show all songs">
                        <TextBlock Text="{x:Bind AllFilterText, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{x:Bind AllPillForeground, Mode=OneWay}"/>
                    </Button>
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Background="{x:Bind FavsPillBackground, Mode=OneWay}"
                            Height="28"
                            Padding="12,0,12,0"
                            Click="OnFilterFavsClick"
                            AutomationProperties.Name="Show favorites">
                        <TextBlock Text="{x:Bind FavsFilterText, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{x:Bind FavsPillForeground, Mode=OneWay}"/>
                    </Button>
                </StackPanel>
            </Border>

            <DropDownButton Grid.Column="4"
                            Content="{x:Bind CurrentSortText, Mode=OneWay}"
                            Style="{StaticResource SubtleButtonStyle}"
                            Height="36"
                            Padding="10,0,10,0"
                            FontSize="13"
                            Foreground="{StaticResource VoidTextSecondaryBrush}">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Title" Click="OnSortTitleClick"/>
                        <MenuFlyoutItem Text="Artist" Click="OnSortArtistClick"/>
                        <MenuFlyoutItem Text="Album" Click="OnSortAlbumClick"/>
                        <MenuFlyoutItem Text="Duration" Click="OnSortDurationClick"/>
                        <MenuFlyoutItem Text="Date added" Click="OnSortDateAddedClick"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- EMPTY LIBRARY -->
        <StackPanel Grid.Row="2"
                    Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420"
                    Spacing="12"
                    Margin="0,0,0,80">
            <FontIcon Glyph="&#xE8D6;"
                      FontSize="32"
                      Foreground="{StaticResource VoidMutedTextBrush}"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="No music yet"
                       Style="{StaticResource VoidSectionTitleTextStyle}"
                       TextAlignment="Center"/>
            <TextBlock Text="Add a folder on this PC. Void Player reads it in place and keeps watching it for new files."
                       FontSize="14"
                       LineHeight="20"
                       Foreground="{StaticResource VoidTextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <Button Style="{StaticResource VoidAccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Click="OnAddFolderClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xED25;" FontSize="13"/>
                    <TextBlock Text="Add music folder"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- FILTERED TO NOTHING (search or favorites) -->
        <TextBlock Grid.Row="2"
                   Visibility="{x:Bind NoResultsVisibility, Mode=OneWay}"
                   Text="{x:Bind NoResultsText, Mode=OneWay}"
                   FontSize="14"
                   Foreground="{StaticResource VoidTextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,80"/>

        <!-- VIRTUALIZED SONGS LIST -->
        <ListView x:Name="SongsListView"
                  Grid.Row="2"
                  Margin="-8,0,-8,0"
                  Visibility="{x:Bind SongsListVisibility, Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.FilteredSongs, Mode=OneWay}"
                  ItemClick="OnSongItemClick"
                  IsItemClickEnabled="True"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <!-- Virtualization Properties for Minimal RAM -->
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel CacheLength="2"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.Header>
                <Grid Height="32"
                      Margin="20,0,20,4"
                      BorderBrush="{StaticResource VoidSelectedBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.4*" MinWidth="140"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource VoidLabelTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Album" Style="{StaticResource VoidLabelTextStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Format" Style="{StaticResource VoidLabelTextStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="Time" Style="{StaticResource VoidLabelTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </ListView.Header>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="12,0,12,0"/>
                    <Setter Property="MinHeight" Value="56"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SongItem">
                    <Grid Height="56"
                          CornerRadius="6"
                          Background="{x:Bind IsCurrentlyPlaying, Mode=OneWay, Converter={StaticResource PlayingRowBackgroundConverter}}">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Edit tags" Tag="{x:Bind}" Click="OnEditTagsClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.4*" MinWidth="140"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>

                        <!-- Artwork; while playing a scrim + glyph replaces the decoration of a colored stripe -->
                        <Grid Grid.Column="0"
                              Width="40"
                              Height="40"
                              Margin="8,0,0,0"
                              CornerRadius="4"
                              HorizontalAlignment="Left"
                              Background="{StaticResource VoidSelectedBrush}">
                            <FontIcon Glyph="&#xE8D6;"
                                      FontSize="14"
                                      Foreground="{StaticResource VoidMutedTextBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            <Image Stretch="UniformToFill"
                                   Source="{x:Bind ArtCacheImageSource, Mode=OneTime}"
                                   Visibility="{Binding ArtCachePath, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <Border Background="#B30F1012"
                                    Visibility="{x:Bind IsCurrentlyPlaying, Mode=OneWay, Converter={StaticResource TrueToVisibleConverter}}">
                                <FontIcon Glyph="&#xE768;"
                                          FontSize="14"
                                          Foreground="{StaticResource VoidAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Playing"/>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2"
                                    Margin="12,0,12,0">
                            <TextBlock Text="{x:Bind Title}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{x:Bind IsCurrentlyPlaying, Mode=OneWay, Converter={StaticResource PlayingTitleBrushConverter}}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Artist}"
                                       Foreground="{StaticResource VoidTextSecondaryBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Album}"
                                   Foreground="{StaticResource VoidTextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="3"
                                   Text="{x:Bind CodecBadge}"
                                   FontSize="12"
                                   Foreground="{StaticResource VoidTextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <Button Grid.Column="4"
                                Style="{StaticResource VoidIconButtonStyle}"
                                Width="36"
                                Height="36"
                                Click="OnItemFavoriteClick"
                                Tag="{x:Bind}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Favorite"
                                ToolTipService.ToolTip="Favorite">
                            <FontIcon Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToHeartGlyphConverter}}"
                                      FontSize="14"
                                      Foreground="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToHeartBrushConverter}}"/>
                        </Button>

                        <TextBlock Grid.Column="5"
                                   Text="{x:Bind FormattedDuration}"
                                   Foreground="{StaticResource VoidTextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
