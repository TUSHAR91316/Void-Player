<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="VoidPlayer.WinUI.Controls.PlayerBarControl"
    x:Name="RootControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:VoidPlayer.WinUI.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToPlayPauseIconConverter x:Key="BoolToPlayPauseIconConverter"/>
        <converters:RepeatModeToIconConverter x:Key="RepeatModeToIconConverter"/>
        <converters:RepeatModeToOpacityConverter x:Key="RepeatModeToOpacityConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:VolumeToIconConverter x:Key="VolumeToIconConverter"/>
        <converters:VolumeToPercentConverter x:Key="VolumeToPercentConverter"/>
    </UserControl.Resources>

    <Border Background="{StaticResource VoidPaneBrush}"
            BorderBrush="{StaticResource VoidSelectedBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,10,20,10"
            Height="84">
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="640"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: current track (select to open Now Playing) -->
            <Grid Grid.Column="0"
                  ColumnSpacing="12"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  IsTapEnabled="True"
                  Tapped="OnTrackInfoTapped"
                  ToolTipService.ToolTip="Open Now Playing">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="52"
                      Height="52"
                      CornerRadius="4"
                      Background="{StaticResource VoidSelectedBrush}">
                    <FontIcon Glyph="&#xE8D6;"
                              FontSize="18"
                              Foreground="{StaticResource VoidMutedTextBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    <Image x:Name="TrackArtImage"
                           Stretch="UniformToFill"
                           Source="{Binding ViewModel.Player.CurrentSong.ArtCachePath, ElementName=RootControl, Converter={StaticResource StringToImageSourceConverter}}"
                           Visibility="{Binding ViewModel.Player.CurrentSong.ArtCachePath, ElementName=RootControl, Converter={StaticResource NullToVisibilityConverter}}"/>
                </Grid>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.Player.CurrentSong.Title, Mode=OneWay, FallbackValue='Nothing playing'}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{StaticResource VoidTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind ViewModel.Player.CurrentSong.Artist, Mode=OneWay, FallbackValue='Pick a song to start'}"
                               FontSize="12"
                               Foreground="{StaticResource VoidTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- CENTER: transport and seek -->
            <Grid Grid.Column="1"
                  VerticalAlignment="Center"
                  RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <Button Style="{StaticResource VoidIconButtonStyle}"
                            Width="36" Height="36"
                            Click="OnShuffleClick"
                            Opacity="{x:Bind ViewModel.Player.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
                            AutomationProperties.Name="Shuffle"
                            ToolTipService.ToolTip="Shuffle">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource VoidIconButtonStyle}"
                            Width="36" Height="36"
                            Click="OnPreviousClick"
                            AutomationProperties.Name="Previous track"
                            ToolTipService.ToolTip="Previous">
                        <FontIcon Glyph="&#xE892;" FontSize="15"/>
                    </Button>

                    <!-- Neutral play button: reads on any album-derived accent -->
                    <Button Width="40"
                            Height="40"
                            Padding="0"
                            CornerRadius="20"
                            BorderThickness="0"
                            Background="{StaticResource VoidTextBrush}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OnPlayPauseClick"
                            AutomationProperties.Name="Play or pause"
                            ToolTipService.ToolTip="Play / Pause">
                        <FontIcon Glyph="{x:Bind ViewModel.Player.IsPlaying, Mode=OneWay, Converter={StaticResource BoolToPlayPauseIconConverter}}"
                                  FontSize="16"
                                  Foreground="{StaticResource VoidGroundBrush}"/>
                    </Button>

                    <Button Style="{StaticResource VoidIconButtonStyle}"
                            Width="36" Height="36"
                            Click="OnNextClick"
                            AutomationProperties.Name="Next track"
                            ToolTipService.ToolTip="Next">
                        <FontIcon Glyph="&#xE893;" FontSize="15"/>
                    </Button>
                    <Button Style="{StaticResource VoidIconButtonStyle}"
                            Width="36" Height="36"
                            Click="OnRepeatClick"
                            Opacity="{x:Bind ViewModel.Player.RepeatMode, Mode=OneWay, Converter={StaticResource RepeatModeToOpacityConverter}}"
                            AutomationProperties.Name="Repeat mode"
                            ToolTipService.ToolTip="Repeat">
                        <FontIcon Glyph="{x:Bind ViewModel.Player.RepeatMode, Mode=OneWay, Converter={StaticResource RepeatModeToIconConverter}}"
                                  FontSize="14"/>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind CurrentPositionText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{StaticResource VoidTextSecondaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                    <Slider x:Name="PositionSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="{x:Bind TotalSeconds, Mode=OneWay}"
                            Value="{x:Bind CurrentSeconds, Mode=TwoWay}"
                            ValueChanged="OnPositionSliderValueChanged"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Seek"
                            Foreground="{x:Bind ViewModel.DynamicAccentBrush, Mode=OneWay}"/>
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind TotalDurationText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{StaticResource VoidTextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- RIGHT: format, open Now Playing, volume -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Player.CurrentSong.CodecBadge, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{StaticResource VoidTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           MaxWidth="140"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind ViewModel.Player.CurrentSong, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Button Style="{StaticResource VoidIconButtonStyle}"
                        Click="OnExpandNowPlayingClick"
                        AutomationProperties.Name="Open Now Playing: lyrics, queue and details"
                        ToolTipService.ToolTip="Lyrics, queue and details">
                    <FontIcon Glyph="&#xE8FD;" FontSize="15"/>
                </Button>
                <FontIcon Glyph="{x:Bind ViewModel.Player.Volume, Mode=OneWay, Converter={StaticResource VolumeToIconConverter}}"
                          FontSize="15"
                          Margin="6,0,4,0"
                          Foreground="{StaticResource VoidTextSecondaryBrush}"
                          VerticalAlignment="Center"/>
                <Slider Width="96"
                        Minimum="0"
                        Maximum="100"
                        StepFrequency="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Volume"
                        Value="{x:Bind ViewModel.Player.Volume, Mode=OneWay, Converter={StaticResource VolumeToPercentConverter}}"
                        ValueChanged="OnVolumeChanged"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
