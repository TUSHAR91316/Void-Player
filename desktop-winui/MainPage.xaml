<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VoidPlayer.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:VoidPlayer.WinUI.Controls"
    xmlns:converters="using:VoidPlayer.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Background="#070C0A">
        <!-- MAIN APP LAYOUT (NAVIGATION + CONTENT + BOTTOM PLAYER BAR) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- NAVIGATION VIEW -->
            <NavigationView x:Name="NavView"
                            Grid.Row="0"
                            PaneDisplayMode="Left"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            SelectionChanged="OnNavSelectionChanged"
                            OpenPaneLength="240"
                            CompactPaneLength="56"
                            Header="">
                <NavigationView.PaneHeader>
                    <Grid Margin="12,12,12,16">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#101C16" BorderBrush="#1F362A" BorderThickness="1">
                                <Image x:Name="NavHeaderLogo" Source="ms-appx:///Assets/Square44x44Logo.png" Stretch="UniformToFill" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Void Player" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" />
                                <TextBlock Text="Hi-Fi Experience" FontSize="11" Foreground="#8B9E94" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </NavigationView.PaneHeader>

                <NavigationView.MenuItems>
                    <NavigationViewItem Content="All Songs" Tag="Songs">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8D6;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Albums" Tag="Albums">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE93C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="AI Hub" Tag="AIHub">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Now Playing" Tag="NowPlaying">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE958;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Content="Settings" Tag="Settings">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <Frame x:Name="ContentFrame" />
            </NavigationView>

            <!-- PERSISTENT BOTTOM PLAYER BAR -->
            <controls:PlayerBarControl Grid.Row="1" ViewModel="{x:Bind ViewModel}" />
        </Grid>

        <!-- DEDICATED NOW PLAYING FULL-SCREEN OVERLAY (Hidden by default to prevent blank overlay) -->
        <Grid x:Name="NowPlayingOverlay"
              Visibility="Collapsed"
              Background="#070C0A">
            <Frame x:Name="NowPlayingFrame" />
        </Grid>
    </Grid>
</Page>
