<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VoidPlayer.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:VoidPlayer.WinUI.Controls"
    xmlns:converters="using:VoidPlayer.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Background="{StaticResource VoidGroundBrush}">
        <!-- MAIN APP LAYOUT (NAVIGATION + CONTENT + BOTTOM PLAYER BAR) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- NAVIGATION VIEW: search at the top, library destinations, settings in the footer.
                 The brand already sits in the title bar, so the pane carries no second logo. -->
            <NavigationView x:Name="NavView"
                            Grid.Row="0"
                            PaneDisplayMode="Left"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            SelectionChanged="OnNavSelectionChanged"
                            OpenPaneLength="248"
                            CompactPaneLength="56"
                            Header="">
                <NavigationView.AutoSuggestBox>
                    <AutoSuggestBox x:Name="LibrarySearchBox"
                                    PlaceholderText="Search songs, artists, albums"
                                    QueryIcon="Find"
                                    AutomationProperties.Name="Search library"
                                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                                    TextChanged="OnSearchTextChanged" />
                </NavigationView.AutoSuggestBox>

                <NavigationView.MenuItems>
                    <NavigationViewItemHeader Content="Library" />
                    <NavigationViewItem Content="Songs" Tag="Songs">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8D6;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Albums" Tag="Albums">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE93C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="AI Hub" Tag="AIHub">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE945;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Now Playing" Tag="NowPlaying">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE958;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Content="Settings" Tag="Settings">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <Frame x:Name="ContentFrame" />
            </NavigationView>

            <!-- PERSISTENT BOTTOM PLAYER BAR -->
            <controls:PlayerBarControl Grid.Row="1" ViewModel="{x:Bind ViewModel}" />
        </Grid>

        <!-- DEDICATED NOW PLAYING FULL-SCREEN OVERLAY (Hidden by default to prevent blank overlay) -->
        <Grid x:Name="NowPlayingOverlay"
              Visibility="Collapsed"
              Background="{StaticResource VoidGroundBrush}">
            <Frame x:Name="NowPlayingFrame" />
        </Grid>
    </Grid>
</Page>
