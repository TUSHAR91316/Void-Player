<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="VoidPlayer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VoidPlayer.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Void Player"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource VoidGroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: one brand mark and the version, nothing else (caption buttons sit on the right) -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40"
              Background="{StaticResource VoidGroundBrush}"
              BorderBrush="{StaticResource VoidSelectedBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,0,16,0">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Image x:Name="TitleBarIconImage"
                       Stretch="Uniform"
                       Width="16"
                       Height="16"
                       VerticalAlignment="Center"/>
                <TextBlock Text="Void Player"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource VoidTextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind AppVersion, Mode=OneTime}"
                           FontSize="12"
                           Foreground="{StaticResource VoidMutedTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Frame x:Name="RootFrame"
               Grid.Row="1"/>
    </Grid>
</Window>
