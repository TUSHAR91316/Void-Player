<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="VoidPlayer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VoidPlayer.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Void Player"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid Background="#070C0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Dark Glass TitleBar -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="42"
              Background="#0A120E"
              BorderBrush="#16251D"
              BorderThickness="0,0,0,1"
              Padding="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Icon & App Title -->
            <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                <Border Width="24"
                        Height="24"
                        CornerRadius="5"
                        Background="#111D17">
                    <Image x:Name="TitleBarIconImage"
                            Stretch="UniformToFill"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Void Player"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Foreground="#FFFFFF"
                        VerticalAlignment="Center"/>
                <Border Background="#132B1F"
                        CornerRadius="4"
                        Padding="6,2,6,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="v2.3"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#00E575"/>
                </Border>
                <Border Width="4"
                        Height="4"
                        CornerRadius="2"
                        Background="#4B5563"
                        VerticalAlignment="Center"/>
                <TextBlock Text="Hi-Fi Audio Experience"
                        FontSize="12"
                        Foreground="#8B9E94"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Frame x:Name="RootFrame"
                Grid.Row="1"/>
    </Grid>
</Window>
